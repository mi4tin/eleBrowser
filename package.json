{
  "name": "elebrowser",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "author": "",
  "license": "ISC",
  "description": "A modern Electron-based browser",
  "devDependencies": {
    "electron": "^39.2.4",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.elebrowser.app",
    "productName": "eleBrowser",
    "directories": {
      "output": "dist-new"
    },
    "files": [
      "main.js",
      "html/**/*",
      "node_modules/**/*",
      "!node_modules/.bin",
      "!node_modules/.cache",
      "assets/**/*",
      "package.json"
    ],
    "electronDist": "./node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "eleBrowser"
    }
  }
}
