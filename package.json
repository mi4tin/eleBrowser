{
  "name": "elebrowser",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
  "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "build": "electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:invox": "npm run build:unpack && build-invox.bat"
  },
  "author": "",
  "license": "ISC",
  "description": "A modern Electron-based browser",
  "devDependencies": {
    "electron": "^39.2.4",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "publish": null,
    "npmRebuild": false,
    "electronDownload": {
      "mirror": "https://registry.npmmirror.com/binary.html?path=electron-builder-binaries/"
    },
    "appId": "com.elebrowser.app",
    "productName": "eleBrowser",
    "directories": {
      "output": "dist-invox"
    },
    "files": [
      "main.js",
      "html/**/*",
      "node_modules/**/*",
      "!node_modules/.bin",
      "!node_modules/.cache",
      "assets/**/*",
      "package.json"
    ],
    "electronDist": "./node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "eleBrowser"
    }
  }
}
